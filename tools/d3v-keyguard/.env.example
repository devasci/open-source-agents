# d3v-keyguard configuration (all optional). Copy to .env; never commit .env.
# KEYGUARD_VAULT_PATH=/path/to/vault.json
# KEYGUARD_PROMPT=auto            # auto | gui | tty
# KEYGUARD_IDLE_TIMEOUT=300       # seconds
# KEYGUARD_MAX_SESSION=3600       # seconds
# KEYGUARD_POLICY_FILE=policy.json
# KEYGUARD_ALLOW_LLM_VALUES=0     # 1 = allow values passed through the model (not recommended)
# KEYGUARD_STORE_REQUIRES_UNLOCK=0

# Demo agent (examples/adk_demo_agent/.env)
# GOOGLE_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash
